{
  "name": "pi-session-title",
  "version": "0.0.2",
  "type": "module",
  "description": "On-demand Pi session titles with the current model, zero-request fallback names, and opt-in automatic generation.",
  "license": "MIT",
  "author": "chenhaoxiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhaoxiang/pi-session-title.git"
  },
  "homepage": "https://github.com/chenhaoxiang/pi-session-title#readme",
  "bugs": "https://github.com/chenhaoxiang/pi-session-title/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "session",
    "title"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "docs/behavior.md",
    "docs/releasing.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/session-title.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "22.19.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
